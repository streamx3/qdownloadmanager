{
  "manifest_version": 3,
  "name": "Download Helper",
  "version": "0.2.3",
  "description": "Send images from your favorite sites to the local Download Helper app.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.joyreactor.cc/*",
    "*://*.joyreactor.com/*",
    "*://*.reactor.cc/*",
    "*://*.reddit.com/*",
    "*://*.i.redd.it/*",
    "*://*.preview.redd.it/*",
    "*://*.external-preview.redd.it/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Download Helper"
  },
  "options_page": "options.html",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
